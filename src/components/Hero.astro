---
const { titulo, bajada } = Astro.props;
---
<section class="hero">
  <div class="contenedor hero__inner">
    <h1>{titulo}</h1>
    {bajada && <p class="hero__bajada">{bajada}</p>}
    <div class="hero__acciones"><slot /></div>
  </div>
</section>

<style>
  .hero { padding-block: var(--esp-24) var(--esp-16); }
  .hero__inner { display: flex; flex-direction: column; gap: var(--esp-6); }
  .hero__bajada { font-size: var(--texto-lg); color: var(--color-texto-suave); }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: var(--esp-4); }
  .hero__acciones:empty { display: none; }
</style>
